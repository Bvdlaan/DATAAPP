{
  "name": "dataapp",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal chat app: Mistral (mistral-small-latest) + Statistics Sweden (SCB PxWebApi v2) tools",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
