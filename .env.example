# Copy to .env and fill in. .env is gitignored — never commit your key.
MISTRAL_API_KEY=
PORT=3000
# Optional: override the SCB PxWebApi v2 base URL
# SCB_API_BASE=https://api.scb.se/OV0104/v2beta/api/v2
# Optional: Nomis (UK) unique ID from your Nomis account ("web services"). Raises the 25,000-cell limit.
# Treat it like a password. The app works without it.
# NOMIS_UID=
