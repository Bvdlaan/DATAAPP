# Copy to .env and fill in. .env is gitignored — never commit your key.
MISTRAL_API_KEY=
PORT=3000
# Optional: override the SCB PxWebApi v2 base URL
# SCB_API_BASE=https://api.scb.se/OV0104/v2beta/api/v2
# Optional: Nomis (UK) unique ID from your Nomis account ("web services"). Raises the 25,000-cell limit.
# Treat it like a password. The app works without it.
# NOMIS_UID=
# Optional: Germany (Destatis GENESIS-Online) personal API token. Find it after logging in at
# https://www-genesis.destatis.de under "Webservice-Schnittstelle (API)". Without it, Germany comes from Eurostat.
# DESTATIS_API_TOKEN=
# Optional but recommended when hosting: Sveriges Riksbank API subscription key (free, from
# https://developer.api.riksbank.se). Without it the Riksbank allows only about 5 requests per minute per IP.
# RIKSBANK_API_KEY=

# Network: by default the server only listens on this computer. To host the backend for the mobile app, set:
# HOST=0.0.0.0
# Behind a hosting proxy/load balancer, identify users by their forwarded address:
# TRUST_PROXY=1

# Usage limits for questions (protect your Mistral bill). Defaults shown.
# CHAT_LIMIT_PER_MINUTE=6
# CHAT_LIMIT_PER_DAY=60
# CHAT_LIMIT_GLOBAL_DAY=2000
